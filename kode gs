const GEMINI_MODEL = "gemini-1.5-flash"; 

// 1. Menerima request HTTP POST dari GitHub Pages
function doPost(e) {
  try {
    const data = JSON.parse(e.postData.contents);
    const action = data.action; // 'chat' atau 'image'
    const prompt = data.prompt;

    let result = {};

    if (action === 'chat') {
      const reply = askChatGPT(prompt);
      result = { status: 'success', data: reply };
    } else if (action === 'image') {
      const imageUrl = generateImagePrompt(prompt);
      result = { status: 'success', data: imageUrl };
    } else {
      result = { status: 'error', message: 'Action tidak valid' };
    }

    return ContentService.createTextOutput(JSON.stringify(result))
      .setMimeType(ContentService.MimeType.JSON);

  } catch (err) {
    return ContentService.createTextOutput(JSON.stringify({
      status: 'error',
      message: err.toString()
    })).setMimeType(ContentService.MimeType.JSON);
  }
}

